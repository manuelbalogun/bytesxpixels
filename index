function updateClock() {
  // Get current time in Lagos, Nigeria (West Africa Time - WAT)
  const now = new Date();
  const lagosTime = new Date(now.toLocaleString('en-US', { 
    timeZone: 'Africa/Lagos' 
  }));
  
  // Format the time (12-hour format with AM/PM)
  let hours = lagosTime.getHours();
  const minutes = String(lagosTime.getMinutes()).padStart(2, '0');
  const seconds = String(lagosTime.getSeconds()).padStart(2, '0');
  
  // Determine AM or PM
  const ampm = hours >= 12 ? 'PM' : 'AM';
  
  // Convert to 12-hour format
  hours = hours % 12;
  hours = hours ? hours : 12; // 0 should be 12
  const hoursFormatted = String(hours).padStart(2, '0');
  
  const timeString = `${hoursFormatted}:${minutes}:${seconds} ${ampm}`;
  
  // Update all elements with class 'clock'
  const clockElements = document.querySelectorAll('.clock');
  clockElements.forEach(el => {
    el.textContent = timeString;
  });
}

// Update immediately on load
updateClock();

// Update every second
setInterval(updateClock, 1000);
</script>




<script>
// Array of inspiring words to cycle through
const words = ["Thrive", "Grow", "Connect", "Inspire", "Captivate", "Validate", "Disrupt", "Scale", "Innovate", "Build", "Launch", "Engage", "Stand out"];

let currentIndex = 0;
const heroElement = document.querySelector('.text-heading-large');

// Function to split text into individual letters wrapped in spans
function splitText(text) {
  return text.split('').map(char => `<span class="letter">${char}</span>`).join('');
}

// Function to animate word in
function animateWordIn() {
  const word = words[currentIndex];
  heroElement.innerHTML = splitText(word);
  
  const letters = heroElement.querySelectorAll('.letter');
  
  // Set initial state
  gsap.set(letters, {
    y: 100,
    opacity: 0,
    rotationX: -90
  });
  
  // Animate in
  gsap.to(letters, {
    y: 0,
    opacity: 1,
    rotationX: 0,
    duration: 0.8,
    stagger: 0.05,
    ease: "back.out(1.7)",
    onComplete: () => {
      // Wait 3.5 seconds before animating out
      setTimeout(animateWordOut, 3500);
    }
  });
}

// Function to animate word out
function animateWordOut() {
  const letters = heroElement.querySelectorAll('.letter');
  
  gsap.to(letters, {
    y: -100,
    opacity: 0,
    rotationX: 90,
    duration: 0.6,
    stagger: 0.03,
    ease: "back.in(1.7)",
    onComplete: () => {
      // Move to next word
      currentIndex = (currentIndex + 1) % words.length;
      animateWordIn();
    }
  });
}

// Add CSS for letter styling
const style = document.createElement('style');
style.textContent = `
  .text-heading-large {
    display: inline-block;
    perspective: 1000px;
  }
  .text-heading-large .letter {
    display: inline-block;
    transform-origin: center bottom;
  }
`;
document.head.appendChild(style);

// Start the animation
animateWordIn();
</script>



